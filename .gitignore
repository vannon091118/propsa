# Abhängigkeiten und Build-Ausgaben
node_modules/
dist/
target/
tauri-app/src-tauri/gen/

# eigene Kontextpakete und Laufzeit-Ausgaben
# Anker "/" am Anfang: propakt-kontext/ und snapshots/ landen im Wurzel-
# verzeichnis des aufrufenden Projekts. Ohne Anker matcht das Muster auch
# jede gleichnamige Unterverzeichnis — und hat docs/snapshots/ mit
# erfasst, wo die Modulindizes liegen.
propakt-kontext/
/snapshots/

# Generierte Ausgaben, wo immer sie entstehen: der Scan schreibt
# test-output/, der Agentenprozess logs/. Beide bleiben unverankert, weil
# die Ausgabe auch in einem Unterprojekt landen kann.
test-output/
logs/

# Berichte unter docs/snapshots/ erzeugt der Agentenprozess bei jedem Lauf.
# Die INDEX.json desselben Ordners sind Handpflege und versioniert.
docs/snapshots/**/*.md

# Werkzeug-Caches, die während der Arbeit entstehen
.agents/
.freebuff/

# V8-Heapsnapshots aus Debug-Sitzungen (Server/TUI, je >60 MB)
*.heapsnapshot

# Generierter Analyse-Output (Funktionsgraph, String-Matrix)
/final_index/

# Generierte Scan-Ausgabe in der Wurzel (1,2 MB, produced by PROPAKT itself)
/kontext.md

# Der Agentenprozess unter agents/ ist ein eigenständiges Paket mit eigener
# Lockdatei und gehört nicht zum Root-Workspace.

# Seitlich abgelegte Fremd-Skripte (nicht Teil von PROPAKT)
*.code.python
*.code.json
Beispiel*.md

# Editor und Betriebssystem
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.swp

# TypeScript-Zwischenstände
*.tsbuildinfo

# Hinweis: package-lock.json und Cargo.lock werden bewusst versioniert,
# damit Builds reproduzierbar sind.
