# Abhängigkeiten und Build-Ausgaben
node_modules/
dist/
target/
tauri-app/src-tauri/gen/

# eigene Kontextpakete und Laufzeit-Ausgaben
# Anker "/" am Anfang: die Ausgaben landen im Wurzelverzeichnis bzw. direkt
# im aufrufenden Projekt. Ohne Anker matcht das Muster auch jede Unter-
# verzeichnis gleichen Namens — und hat docs/snapshots/ mit erfasst, wo
# versionierte Berichte liegen.
propsa-kontext/
/test-output/
/logs/
/snapshots/

# Werkzeug-Caches, die während der Arbeit entstehen
.agents/
.freebuff/

# V8-Heapsnapshots aus Debug-Sitzungen (Server/TUI, je >60 MB)
*.heapsnapshot

# Generierter Analyse-Output (Funktionsgraph, String-Matrix)
/final_index/

# Generierte Scan-Ausgabe in der Wurzel (1,2 MB, produced by PROPSA itself)
/kontext.md

# Der Agentenprozess unter agents/ ist ein eigenständiges Paket mit eigener
# Lockdatei und gehört nicht zum Root-Workspace.

# Seitlich abgelegte Fremd-Skripte (nicht Teil von PROPSA)
*.code.python
*.code.json
Beispiel*.md

# Editor und Betriebssystem
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
*.swp

# TypeScript-Zwischenstände
*.tsbuildinfo

# Hinweis: package-lock.json und Cargo.lock werden bewusst versioniert,
# damit Builds reproduzierbar sind.
