{
  "skill": {
    "name": "HERMES",
    "version": "1.0.0",
    "mode": "active",
    "language": "de"
  },
  "shinon": {
    "enabled": true,
    "interval_seconds": 300,
    "snapshot_path": "./snapshots/repo_snapshots/",
    "diff_path": "./snapshots/diffs/",
    "create_markdown": true,
    "german_explanations": true,
    "fun_mode": true,
    "min_changes_for_report": 1,
    "max_snapshots_retained": 100
  },
  "repository": {
    "scan_root": "./",
    "ignore_patterns": [
      ".git",
      ".gitignore",
      "node_modules",
      "__pycache__",
      ".venv",
      "dist",
      "build",
      ".DS_Store",
      "*.pyc",
      ".env",
      "snapshots",
      "logs"
    ],
    "include_extensions": [
      ".py", ".gd", ".js", ".ts", ".md", ".json",
      ".yaml", ".yml", ".sh", ".go", ".rs", ".java"
    ]
  },
  "heartbeat": {
    "enabled": true,
    "interval_seconds": 180,
    "check_type": "quick_state_hash"
  },
  "snapshots": {
    "enabled": true,
    "interval_seconds": 300,
    "full_tree": true,
    "include_loc": true,
    "storage_path": "./snapshots/repo_snapshots/",
    "max_snapshots_retained": 50,
    "format": "markdown"
  },
  "nim": {
    "provider": "nvidia_nim",
    "model": "nemotron-4-340b-instruct",
    "endpoint": "http://localhost:8000/v1",
    "rpm_limit": 40,
    "timeout_seconds": 30,
    "temperature": 0.3,
    "max_tokens": 1024
  },
  "analysis": {
    "detect_refactoring": true,
    "detect_file_moves": true,
    "detect_structural_changes": true,
    "min_change_threshold_lines": 5
  },
  "logging": {
    "level": "INFO",
    "heartbeat_log": "./logs/heartbeat.log",
    "changes_log": "./logs/changes.log",
    "errors_log": "./logs/errors.log",
    "retention_days": 30
  }
}