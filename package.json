{
  "name": "propakt",
  "version": "0.0.19",
  "description": "PROPAKT — Projekt-Scankontext als Kontextpaket für LLMs",
  "main": "dist/propakt.js",
  "bin": {
    "propakt": "./dist/propakt.js"
  },
  "scripts": {
    "build": "npm run build --workspace @propakt/core && tsc && tsc -p bausteine/tsconfig.json",
    "start": "ts-node src/propakt.ts",
    "pruefen": "node scripts/pruefen/pruefen.mjs",
    "changelog:spiegeln": "node scripts/changelog/changelog_spiegeln.mjs",
    "installieren": "node scripts/installation/install.mjs",
    "deinstallieren": "node scripts/installation/deinstall.mjs",
    "clean": "node scripts/maintenance/clean-node.js",
    "validate": "npm run pruefen && bash scripts/version/check-versions.sh",
    "architecture:check": "node scripts/architecture-check.mjs"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@propakt/core": "*",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
