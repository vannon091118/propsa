{
  "name": "propsa",
  "version": "0.0.16",
  "description": "PROPSA — Projekt-Scankontext als Kontextpaket für LLMs",
  "main": "dist/propsa.js",
  "bin": {
    "propsa": "./dist/propsa.js"
  },
  "scripts": {
    "build": "npm run build --workspace @propsa/core && tsc",
    "start": "ts-node src/propsa.ts",
    "pruefen": "node scripts/pruefen.mjs",
    "changelog:spiegeln": "node scripts/changelog_spiegeln.mjs",
    "installieren": "node scripts/install.mjs",
    "deinstallieren": "node scripts/deinstall.mjs",
    "clean": "node scripts/clean-node.js",
    "validate": "npm run pruefen && bash scripts/check-versions.sh"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@propsa/core": "*",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
